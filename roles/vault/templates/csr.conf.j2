[ req ]
default_bits       = 2048
prompt             = no
default_md         = sha256
req_extensions     = req_ext
distinguished_name = dn


[ dn ]
C  = TR
ST = ISTANBUL
L  = MARMARA
O  = DEVOPS VAULT
OU = VAULT
CN = *.{{ vault_domain_name }}

[ req_ext ]
subjectAltName = @alt_names

[ alt_names ]
{% for idx, dnsname in vault_tls_alt_names.dns|default([]) | enumerate %}
DNS.{{ idx+1 }} = {{ dnsname }}
{% endfor %}
{% for idx, ipaddr in vault_tls_alt_names.ip|default([]) | enumerate %}
IP.{{ idx+1 }} = {{ ipaddr }}
{% endfor %}

[ v3_ext ]
authorityKeyIdentifier=keyid,issuer:always
basicConstraints=CA:FALSE
keyUsage=nonRepudiation, digitalSignature, keyEncipherment
extendedKeyUsage=serverAuth,clientAuth
subjectAltName=@alt_names
